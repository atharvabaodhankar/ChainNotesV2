# ── Privy Configuration ──
VITE_PRIVY_APP_ID=sandbox

# ── Pimlico Account Abstraction ──
VITE_PIMLICO_API_KEY=

# ── Blockchain RPCs & Deployed Contracts ──
VITE_RPC_URL=https://rpc-amoy.polygon.technology
# (Optional) Contract address - generated automatically by deploy script, but can be overridden here
VITE_CONTRACT_ADDRESS=

# ── Pinata IPFS Gateway & Pinning Keys ──
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_API_SECRET=your_pinata_api_secret_here
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY_URL=https://gateway.pinata.cloud
VITE_PINATA_GATEWAY_TOKEN=your_pinata_gateway_token_here


